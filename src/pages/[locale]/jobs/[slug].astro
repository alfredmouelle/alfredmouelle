---
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

import Reveal from '~/components/astro/Reveal.astro';
import { JobDate } from '~/components/job-card';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbList,
  BreadcrumbSeparator,
} from '~/components/ui/breadcrumb';
import { Button } from '~/components/ui/button';

import { AppConfig } from '~/app.config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getJobSlug, getJobs } from '~/lib/jobs';
import { breadcrumbSchema, creativeWorkSchema } from '~/lib/jsonld';
import { cn } from '~/lib/utils';
import {
  createScopedTranslator,
  LOCALES,
  type Locale,
  normalizeLocale,
} from '~/locales';

export async function getStaticPaths() {
  const paths = await Promise.all(
    LOCALES.map(async (locale: Locale) => {
      const jobs = await getJobs(locale);
      return jobs.map((job) => ({
        params: { locale, slug: getJobSlug(job) },
        props: { job },
      }));
    })
  );
  return paths.flat();
}

const { job } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const tBC = createScopedTranslator(locale, 'breadcrumb');
const tJobs = createScopedTranslator(locale, 'section_jobs');
const tJob = createScopedTranslator(locale, 'job');
const tPeriod = createScopedTranslator(locale, 'job.period');

const allJobs = await getJobs(locale);

const labels = {
  elapsed: tPeriod('elapsed'),
  from: tPeriod('from'),
  to: tPeriod('to'),
};

const { Content } = await render(job);

const slug = getJobSlug(job);
const title = `${job.data.position} at ${job.data.company}`;
const canonical = `${AppConfig.domain}${getRelativeLocaleUrl(locale, `/jobs/${slug}`)}`;
const ogImage = `/og/${locale}/jobs/${slug}.png`;

const jsonLd = [
  breadcrumbSchema([
    {
      name: tBC('home'),
      url: `${AppConfig.domain}${getRelativeLocaleUrl(locale, '/')}`,
    },
    {
      name: tBC('jobs'),
      url: `${AppConfig.domain}${getRelativeLocaleUrl(locale, '/jobs')}`,
    },
    { name: title, url: canonical },
  ]),
  creativeWorkSchema({
    locale,
    type: 'Article',
    name: title,
    description: job.data.description,
    url: canonical,
    image: ogImage,
    datePublished: job.data.startDate.toISOString(),
    keywords: job.data.meta.keywords,
  }),
];
---

<BaseLayout
  title={title}
  description={job.data.description}
  keywords={job.data.meta.keywords}
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  jsonLd={jsonLd}
>
  <div
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 lg:pt-28 pb-16 lg:pb-20 font-sans"
  >
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-14">
      <aside
        class="lg:col-span-4 lg:sticky lg:top-24 lg:h-[calc(100dvh-7.5rem)] lg:overflow-y-auto lg:pr-2 space-y-5"
      >
        <Breadcrumb className="text-xs text-muted-foreground font-mono">
          <BreadcrumbList>
            <BreadcrumbItem>
              <a
                href={getRelativeLocaleUrl(locale, "/")}
                class="transition-colors hover:text-foreground"
              >
                {tBC("home")}
              </a>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <a
                href={getRelativeLocaleUrl(locale, "/jobs")}
                class="text-muted-foreground transition-colors hover:text-foreground"
              >
                {tBC("jobs")}
              </a>
            </BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>

        <div
          class="border-b border-border/70 pb-3 flex items-baseline justify-between"
        >
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs font-bold text-primary">03.</span>
            <h2
              class="font-display text-sm font-bold tracking-tight text-foreground uppercase"
            >
              {tJobs("title")}
            </h2>
          </div>
          <span class="font-mono text-xs text-muted-foreground"
            >({allJobs.length})</span
          >
        </div>

        <nav class="space-y-1.5 font-mono text-xs">
          {
            allJobs.map((j) => {
              const jSlug = getJobSlug(j);
              const isActive = jSlug === slug;
              const isCurrent =
                !j.data.endDate || new Date(j.data.endDate) > new Date();
              return (
                <a
                  href={getRelativeLocaleUrl(locale, `/jobs/${jSlug}`)}
                  class={cn(
                    "group flex flex-col gap-1 rounded p-3 transition duration-200 border",
                    isActive
                      ? "border-primary/40 bg-primary/10 text-foreground shadow-xs"
                      : "border-transparent text-muted-foreground hover:bg-muted/40 hover:text-foreground",
                  )}
                >
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5 truncate">
                      {isActive && (
                        <span class="size-1.5 rounded bg-primary shrink-0 animate-pulse" />
                      )}
                      <span
                        class={cn(
                          "truncate font-display text-sm font-semibold",
                          isActive
                            ? "text-primary"
                            : "group-hover:text-foreground",
                        )}
                      >
                        {j.data.company}
                      </span>
                    </div>
                    {isCurrent ? (
                      <span class="rounded bg-primary/20 px-1.5 py-0.5 font-mono text-[9px] font-semibold text-primary uppercase">
                        {tJob("current")}
                      </span>
                    ) : null}
                  </div>
                  <p class="text-[11px] font-mono text-primary/80 truncate">
                    {j.data.position}
                  </p>
                </a>
              );
            })
          }
        </nav>
      </aside>

      <main class="lg:col-span-8 space-y-8">
        <Reveal type="slide-up" class="space-y-8">
          <header class="flex flex-col gap-4 border-b border-border/70 pb-6">
            <div
              class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2"
            >
              <h1
                class="font-display text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
              >
                {job.data.company}
              </h1>
              <div class="font-mono text-xs text-muted-foreground">
                <JobDate
                  startDate={job.data.startDate}
                  endDate={job.data.endDate}
                  locale={locale}
                  labels={labels}
                />
              </div>
            </div>

            <p class="text-sm font-medium text-primary font-mono">
              {job.data.position}
            </p>

            <p
              class="text-sm sm:text-base leading-relaxed text-muted-foreground text-pretty"
            >
              {job.data.description}
            </p>

            {
              job.data.stacks?.length > 0 && (
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {job.data.stacks.map((st: string) => (
                    <span class="rounded border border-border/70 bg-card px-2.5 py-0.5 font-mono text-xs text-muted-foreground">
                      {st}
                    </span>
                  ))}
                </div>
              )
            }

            <div class="mt-1 flex flex-wrap items-center gap-3">
              {
                job.data.siteUrl ? (
                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href={job.data.siteUrl}
                    class="font-mono text-xs font-medium text-primary underline-offset-4 hover:underline"
                  >
                    {tJob("visitWebsite")}
                  </a>
                ) : null
              }
            </div>
          </header>

          <article
            class="prose prose-neutral w-full max-w-none dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline hover:prose-a:underline"
          >
            <Content components={{ Button }} />
          </article>
        </Reveal>
      </main>
    </div>
  </div>
</BaseLayout>
