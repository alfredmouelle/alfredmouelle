---
import { getRelativeLocaleUrl } from 'astro:i18n';

import Reveal from '~/components/astro/Reveal.astro';
import Section from '~/components/astro/Section.astro';
import SectionHeader from '~/components/astro/SectionHeader.astro';
import { JobCard } from '~/components/job-card';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '~/components/ui/breadcrumb';

import { AppConfig } from '~/app.config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getJobSlug, getJobs } from '~/lib/jobs';
import { createScopedTranslator, LOCALES, normalizeLocale } from '~/locales';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.currentLocale);
const t = createScopedTranslator(locale, 'breadcrumb');
const tSection = createScopedTranslator(locale, 'section_jobs');
const tJob = createScopedTranslator(locale, 'job');
const tPeriod = createScopedTranslator(locale, 'job.period');

const labels = {
  readTime: tJob('readTime'),
  elapsed: tPeriod('elapsed'),
  from: tPeriod('from'),
  to: tPeriod('to'),
};

const jobs = await getJobs(locale);
const canonical = `${AppConfig.domain}${getRelativeLocaleUrl(locale, '/jobs')}`;
---

<BaseLayout title={tSection('title')} canonical={canonical}>
  <Section class="hero mt-20" skipFadeIn>
    <Breadcrumb className="mb-6 text-sm text-muted-foreground">
      <BreadcrumbList>
        <BreadcrumbItem>
          <a
            href={getRelativeLocaleUrl(locale, '/')}
            class="transition-colors hover:text-foreground"
          >
            {t('home')}
          </a>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{t('jobs')}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <SectionHeader
      eyebrow={tSection('eyebrow')}
      title={tSection('title')}
      description={tSection('description')}
    />

    <ul class="grid gap-4 md:grid-cols-2">
      {
        jobs.map((job, index) => (
          <Reveal as="li" type="slide-up" delay={index * 60}>
            <a
              href={getRelativeLocaleUrl(locale, `/jobs/${getJobSlug(job)}`)}
              class="block h-full"
            >
              <JobCard job={job.data} locale={locale} labels={labels} />
            </a>
          </Reveal>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
