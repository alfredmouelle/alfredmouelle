---
import HomeSplitCraft from '~/components/sections/HomeSplitCraft.astro';

import BaseLayout from '~/layouts/BaseLayout.astro';
import { getComeUpStats } from '~/lib/comeup';
import { getJobs } from '~/lib/jobs';
import { getProjects } from '~/lib/projects';
import { LOCALES, normalizeLocale } from '~/locales';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.currentLocale);
const projects = await getProjects(locale);
const jobs = await getJobs(locale);
const comeupStats = await getComeUpStats();
---

<BaseLayout showFooter={false}>
  <HomeSplitCraft projects={projects} jobs={jobs} comeupStats={comeupStats} />
</BaseLayout>
