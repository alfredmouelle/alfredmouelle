---
import { getRelativeLocaleUrl } from "astro:i18n";

import ProjectCard from "~/components/astro/ProjectCard.astro";
import Reveal from "~/components/astro/Reveal.astro";
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "~/components/ui/breadcrumb";

import { AppConfig } from "~/app.config";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getProjectSlug, getProjects } from "~/lib/projects";
import { createScopedTranslator, LOCALES, normalizeLocale } from "~/locales";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.currentLocale);
const t = createScopedTranslator(locale, "breadcrumb");
const tSection = createScopedTranslator(locale, "section_projects");

const projects = await getProjects(locale);
const canonical = `${AppConfig.domain}${getRelativeLocaleUrl(locale, "/projects")}`;

const allStacks = Array.from(
  new Set(projects.flatMap((p) => p.data.stacks || [])),
).sort();
---

<BaseLayout title={tSection("title")} canonical={canonical}>
  <div
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 lg:pt-28 pb-16 lg:pb-20 font-sans"
  >
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-14">
      <aside
        class="lg:col-span-4 lg:sticky lg:top-24 lg:h-[calc(100dvh-7.5rem)] lg:overflow-y-auto lg:pr-2 space-y-6"
      >
        <Breadcrumb className="text-xs text-muted-foreground font-mono">
          <BreadcrumbList>
            <BreadcrumbItem>
              <a
                href={getRelativeLocaleUrl(locale, "/")}
                class="transition-colors hover:text-foreground"
              >
                {t("home")}
              </a>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbPage className="font-semibold text-foreground"
                >{t("projects")}</BreadcrumbPage
              >
            </BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>

        <div class="space-y-2 border-b border-border/70 pb-4">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs font-bold text-primary">02.</span>
            <h1
              class="font-display text-2xl font-bold tracking-tight text-foreground uppercase sm:text-3xl"
            >
              {tSection("title")}
            </h1>
          </div>
          <p class="font-mono text-xs text-muted-foreground">
            {projects.length}
            {tSection("count")}
          </p>
        </div>

        <p
          class="text-xs sm:text-sm leading-relaxed text-muted-foreground text-pretty"
        >
          {tSection("description")}
        </p>

        {
          allStacks.length > 0 && (
            <div class="space-y-2.5 rounded border border-border/70 bg-card p-4 shadow-soft">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] font-semibold text-foreground uppercase tracking-wider">
                  {locale === "fr"
                    ? "Technologies mobilisées"
                    : "Technologies used"}
                </span>
                <span class="font-mono text-[11px] text-muted-foreground">
                  ({allStacks.length})
                </span>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {allStacks.map((stack) => (
                  <span class="rounded border border-border/60 bg-background/80 px-2 py-0.5 font-mono text-[10px] text-muted-foreground">
                    {stack}
                  </span>
                ))}
              </div>
            </div>
          )
        }

        <div
          class="rounded border border-primary/20 bg-primary/5 p-4 space-y-2"
        >
          <p class="font-display text-xs font-bold text-foreground">
            {
              locale === "fr"
                ? "Un projet à concrétiser ?"
                : "Have a project in mind?"
            }
          </p>
          <p class="text-[11px] leading-relaxed text-muted-foreground">
            {
              locale === "fr"
                ? "Disponible pour concevoir et développer votre produit web ou mobile."
                : "Available to design and build your web or mobile product."
            }
          </p>
          <a
            href={`${getRelativeLocaleUrl(locale, "/")}?anchor=contact`}
            class="inline-block font-mono text-xs font-semibold text-primary hover:underline underline-offset-4 pt-1"
          >
            {
              locale === "fr"
                ? "Initier une collaboration"
                : "Start a conversation"
            }
          </a>
        </div>
      </aside>

      <main class="lg:col-span-8 space-y-6">
        <ul class="grid grid-cols-1 gap-8">
          {
            projects.map((project, index) => (
              <Reveal as="li" type="slide-up" delay={index * 50}>
                <ProjectCard
                  project={project.data}
                  href={getRelativeLocaleUrl(
                    locale,
                    `/projects/${getProjectSlug(project)}`,
                  )}
                />
              </Reveal>
            ))
          }
        </ul>
      </main>
    </div>
  </div>
</BaseLayout>
