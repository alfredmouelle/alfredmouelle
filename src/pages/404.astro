---
import { Icon } from '~/components/icons';
import { Button } from '~/components/ui/button';

import BaseLayout from '~/layouts/BaseLayout.astro';
import { LOCALES } from '~/locales';
import en from '~/locales/dictionaries/en';
import fr from '~/locales/dictionaries/fr';

// Static 404 has no build-time locale; render default + swap strings at runtime.
const dicts = { fr: fr.notFound, en: en.notFound } as const;
const labels = dicts.fr;
---

<BaseLayout title={labels.title} noindex showFooter={false}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 lg:pt-28 pb-16 lg:pb-20 font-sans flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="font-display text-[clamp(5rem,18vw,11rem)] leading-none text-primary/15">
      404
    </p>
    <h1 class="mt-2 font-display text-2xl md:text-3xl" data-i18n="title">
      {labels.title}
    </h1>
    <p class="mb-8 mt-3 max-w-md text-muted-foreground" data-i18n="message">
      {labels.message}
    </p>
    <a id="not-found-home" href="/">
      <Button>
        <Icon name="home" className="size-4" />
        <span data-i18n="backHome">{labels.backHome}</span>
      </Button>
    </a>
  </div>
</BaseLayout>

<script is:inline define:vars={{ dicts, locales: LOCALES, defaultLocale: 'fr' }}>
  // @ts-nocheck
  (function () {
    const segs = location.pathname.split('/').filter(Boolean);
    const candidate = segs[0];
    const locale = locales.includes(candidate) ? candidate : defaultLocale;
    const dict = dicts[locale];
    if (!dict) return;
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key]) el.textContent = dict[key];
    });
    document.documentElement.lang = locale;
    const home = document.getElementById('not-found-home');
    if (home) home.setAttribute('href', `/${locale}/`);
  })();
</script>
