---
import { Image } from 'astro:assets';

import type { ProjectEntry } from '~/lib/projects';

interface Props {
  project: ProjectEntry['data'];
  href: string;
}

const { project, href } = Astro.props;
const stacks = project.stacks || [];
---

<a
  href={href}
  class="group block overflow-hidden rounded border border-border/70 bg-card shadow-soft transition duration-300 ease-out hover:-translate-y-1 hover:border-primary/40 hover:shadow-float"
>
  {
    project.cover ? (
      <div class="aspect-[16/9] w-full overflow-hidden border-b border-border/70 bg-muted">
        <Image
          src={project.cover}
          alt={project.title}
          width={1200}
          height={675}
          widths={[480, 720, 1080, 1200]}
          sizes="(max-width: 1024px) 100vw, 820px"
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
        />
      </div>
    ) : null
  }

  <div class="p-6 sm:p-7 space-y-3.5">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <div class="flex items-center gap-2">
        <h3
          class="font-display text-lg sm:text-xl font-bold tracking-tight text-foreground group-hover:text-primary transition-colors"
        >
          {project.title}
        </h3>
      </div>
      <span class="font-mono text-xs font-semibold tabular-nums text-primary">
        [{project.year}]
      </span>
    </div>

    {
      project.role ? (
        <p class="font-mono text-xs font-medium text-primary">{project.role}</p>
      ) : null
    }

    <p
      class="text-xs sm:text-sm leading-relaxed text-muted-foreground text-pretty"
    >
      {project.description}
    </p>

    {
      stacks.length > 0 ? (
        <ul class="flex flex-wrap items-center gap-1.5 pt-1">
          {stacks.map((stack) => (
            <li class="shrink-0 rounded border border-border/70 bg-background/70 px-2.5 py-0.5 font-mono text-[11px] text-muted-foreground">
              {stack}
            </li>
          ))}
        </ul>
      ) : null
    }
  </div>
</a>
